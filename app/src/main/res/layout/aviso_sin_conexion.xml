<?xml version="1.0" encoding="utf-8"?>
<!-- Franja "Sin conexión a internet" arriba de la pantalla (se quita sola al volver la conexión) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/avisoSinConexion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_aviso_sin_conexion"
    android:elevation="4dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:paddingVertical="12dp"
    android:accessibilityLiveRegion="polite">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sin_wifi"
        app:tint="@color/pink_text"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sin_internet"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:fontFamily="@font/nunito_extrabold"/>
        <TextView
            android:id="@+id/tvSinConexionTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:fontFamily="@font/nunito_regular"/>
    </LinearLayout>
</LinearLayout>
