<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondo_inicio">

    <!-- Burbujas y puntitos pastel decorativos (detrás de todo) -->
    <View
        android:layout_width="168dp"
        android:layout_height="168dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-48dp"
        android:layout_marginEnd="-48dp"
        android:background="@drawable/bg_blob_blue"/>
    <View
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="54dp"
        android:layout_marginStart="-66dp"
        android:background="@drawable/bg_blob_lilac"/>
    <View
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-54dp"
        android:layout_marginStart="-54dp"
        android:background="@drawable/bg_blob_pink"/>
    <View
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="456dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_blob_mint"/>
    <View
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="274dp"
        android:layout_marginEnd="31dp"
        android:background="@drawable/bg_blob_yellow"/>
    <View
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="372dp"
        android:layout_marginStart="-19dp"
        android:background="@drawable/bg_blob_blue"/>
    <View
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="108dp"
        android:layout_marginEnd="-29dp"
        android:background="@drawable/bg_blob_lilac"/>
    <View
        android:layout_width="31dp"
        android:layout_height="31dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="216dp"
        android:layout_marginStart="19dp"
        android:background="@drawable/bg_blob_pink"/>
    <View
        android:layout_width="29dp"
        android:layout_height="29dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="564dp"
        android:layout_marginStart="-12dp"
        android:background="@drawable/bg_blob_yellow"/>
    <View
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="34dp"
        android:layout_marginStart="120dp"
        android:background="@drawable/bg_blob_pink"/>
    <View
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="180dp"
        android:background="@drawable/bg_blob_mint"/>
    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="142dp"
        android:background="@drawable/bg_blob_lilac"/>
    <View
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="278dp"
        android:layout_marginStart="53dp"
        android:background="@drawable/bg_blob_mint"/>
    <View
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_blob_yellow"/>
    <View
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="72dp"
        android:layout_marginStart="156dp"
        android:background="@drawable/bg_blob_blue"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- px-8 py-6, contenido centrado verticalmente, gap-6 (24dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="24dp">

            <!-- Logo + título -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="8dp">

                <!-- Logo de StudyMate: el mismo dibujo del ícono de la app (libro + birrete).
                     La imagen mide 108dp y el cuadro 72dp: se ve el centro, igual que en el ícono. -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_logo"
                    android:elevation="8dp"
                    android:outlineSpotShadowColor="#607563C0"
                    android:clipToOutline="true"
                    android:importantForAccessibility="no">
                    <ImageView
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/logo_login"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_name"
                    android:textSize="28sp"
                    android:letterSpacing="-0.018"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/nunito_extrabold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/lema"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/nunito_medium"/>
            </LinearLayout>

            <!-- Fila de iconos: 52x52, radio 16, gap 16 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_blue"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_libro"
                    app:tint="@color/icono_blue"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_icon_yellow"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_editar"
                    app:tint="@color/icono_yellow"
                    android:scaleType="fitCenter"/>
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_icon_mint"
                    android:importantForAccessibility="no"
                    android:padding="14dp"
                    android:src="@drawable/ic_calendario"
                    app:tint="@color/icono_mint"
                    android:scaleType="fitCenter"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/bienvenido"
                android:textSize="22sp"
                android:textColor="@color/text_main"
                android:fontFamily="@font/nunito_extrabold"/>

            <!-- Campos (gap 16 entre ellos) -->
            <TextView
                style="@style/App.Label"
                android:layout_marginTop="24dp"
                android:text="@string/correo"/>
            <EditText
                android:id="@+id/etCorreo"
                style="@style/App.Input.Claro"
                android:hint="@string/correo_hint"
                android:inputType="textEmailAddress"/>

            <TextView
                style="@style/App.Label"
                android:layout_marginTop="16dp"
                android:text="@string/contrasena"/>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:hintEnabled="false"
                app:boxBackgroundMode="none"
                app:endIconMode="password_toggle"
                app:endIconDrawable="@drawable/ic_password_toggle"
                app:endIconTint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/App.Input.Claro"
                    android:layout_marginTop="0dp"
                    android:hint="@string/contrasena_hint"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error del inicio de sesión: ⚠ + texto rojo debajo del campo (se oculta al escribir) -->
            <TextView
                android:id="@+id/tvErrorLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_alerta"
                android:drawablePadding="6dp"
                android:drawableTint="@color/red_text"
                android:gravity="center_vertical"
                android:accessibilityLiveRegion="polite"
                android:textSize="13sp"
                android:textColor="@color/red_text"
                android:fontFamily="@font/nunito_bold"
                android:visibility="gone"/>

            <!-- Olvidaste (gap 24 - 8 = 16) -->
            <TextView
                android:id="@+id/tvOlvidaste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:gravity="center_vertical|end"
                android:background="?attr/selectableItemBackground"
                android:text="@string/olvidaste"
                android:textSize="13sp"
                android:textColor="@color/texto_acento"
                android:fontFamily="@font/nunito_semibold"/>

            <!-- Botón: padding 14/20, radio 16, 16px bold, sombra -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingVertical="16dp"
                android:text="@string/iniciar_sesion"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:fontFamily="@font/nunito_bold"
                android:elevation="6dp"
                android:outlineSpotShadowColor="#607563C0"
                app:backgroundTint="@color/boton"
                app:cornerRadius="16dp"/>

            <!-- Se ve mientras se inicia sesión (retroalimentación de carga) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresoLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:contentDescription="@string/iniciando_sesion"
                app:indicatorColor="@color/boton"
                app:trackCornerRadius="4dp"/>

            <!-- ─── o ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:importantForAccessibility="noHideDescendants">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                    android:background="@color/divider"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="@string/o"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/nunito_semibold"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                    android:background="@color/divider"/>
            </LinearLayout>

            <!-- Continuar con Google -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="48dp"
                android:text="@string/continuar_google"
                android:textAllCaps="false"
                android:letterSpacing="0"
                android:textSize="14sp"
                android:textColor="@color/text_label"
                android:fontFamily="@font/nunito_semibold"
                app:backgroundTint="@color/card_bg"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="18dp"
                app:iconTint="@null"
                app:strokeColor="@color/borde_google"
                app:strokeWidth="1dp"/>

            <!-- Se ve mientras se entra con Google (su propia barra, debajo de su botón) -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progresoGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:contentDescription="@string/conectando_google"
                app:indicatorColor="@color/boton"
                app:trackCornerRadius="4dp"/>

            <!-- ¿No tienes cuenta? Crear cuenta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sin_cuenta"
                    android:textSize="14sp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/nunito_regular"/>
                <TextView
                    android:id="@+id/tvCrearCuenta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingHorizontal="4dp"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/crear_cuenta"
                    android:textSize="14sp"
                    android:textColor="@color/texto_acento"
                    android:fontFamily="@font/nunito_bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
