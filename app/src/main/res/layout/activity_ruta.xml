<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo llegar (dentro de la app): ruta a pie en OpenStreetMap desde tu ubicación hasta el salón -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">
        <ImageView
            style="@style/App.BackButton"
            android:id="@+id/btnAtras"
            android:background="@drawable/bg_back_blue"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                style="@style/App.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ruta_titulo"/>
            <TextView
                android:id="@+id/tvDestino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:fontFamily="@font/nunito_semibold"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <org.osmdroid.views.MapView
            android:id="@+id/mapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- Tarjeta inferior: tiempo (grande), distancia y botón para recalcular -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="64dp"
            android:background="@drawable/bg_card_20"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:paddingVertical="16dp">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_lilac"
                android:importantForAccessibility="no"
                android:padding="11dp"
                android:src="@drawable/ic_caminar"
                app:tint="@color/icono_lilac"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ProgressBar
                        android:id="@+id/progresoRuta"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminateTint="@color/boton"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tvRutaInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/ruta_calculando"
                        android:textColor="@color/text_main"
                        android:textSize="20sp"
                        android:fontFamily="@font/nunito_extrabold"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvRutaDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:fontFamily="@font/nunito_semibold"
                    android:visibility="gone"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/btnRecalcular"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_back_blue"
                android:contentDescription="@string/ruta_recalcular"
                android:padding="12dp"
                android:src="@drawable/ic_recalcular"
                app:tint="@color/texto_acento"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
